id=tango-translator
name=Tango Binary Translator
version=v2.1.0
versionCode=2100
author=Amanieu d'Antras
minKernelVersion=5.6
description=KernelSU module for Tango binary translator - enables ARM32 CLI tools on ARM64-only devices without modifying ROM

# This module provides:
# - tango_translator binary for ARM32→ARM64 translation
# - tango-pretranslate for ahead-of-time translation
# - Runtime toggles for tango32 and ntsync kernel modules
# - binfmt_misc auto-registration for ARM32 ELF files
# 
# Requirements:
# - tango32 and ntsync kernel modules in /vendor_dlkm/
# - Standard ARM32 Bionic libraries (already in /system/lib/)
# 
# Usage:
# tango <arm32-binary> [args...]
# Or directly:
# /system/bin/tango_translator /path/to/arm32-binary [args...]
